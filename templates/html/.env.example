# Copy this file to .env and fill in ACCESS_TOKEN.
# Taggbox dashboard -> your gallery's card -> three-dot menu -> "Access Token".
ACCESS_TOKEN=
# Always this value - nothing to copy from the dashboard.
API_BASE_URL=https://api.taggbox.com/api
# Theme file name from the themes/ folder, e.g. modern-card, vivid, review-list.
WIDGET_THEME=modern-card
